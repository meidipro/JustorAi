{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCBDLandmarkCaseSchema",
  "type": "object",
  "required": [
    "case_id",
    "case_title",
    "citation",
    "court_division",
    "year",
    "judgment_date",
    "subject_area",
    "governing_statutes",
    "facts_summary",
    "legal_issues",
    "ratio_decidendi",
    "exact_key_passages",
    "verification_status"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^SCBD-(AD|HCD)-[0-9]{4}-[0-9]{3,4}$"
    },
    "case_title": {
      "type": "string",
      "minLength": 5
    },
    "citation": {
      "type": "string",
      "description": "Standard citation e.g. 67 DLR (AD) 142 or 20 BLD (HCD) 89"
    },
    "court_division": {
      "type": "string",
      "enum": ["Appellate Division", "High Court Division"]
    },
    "year": {
      "type": "integer",
      "minimum": 1971,
      "maximum": 2026
    },
    "judgment_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "bench_judges": {
      "type": "array",
      "items": { "type": "string" }
    },
    "subject_area": {
      "type": "string",
      "enum": [
        "Property & Land Law",
        "Civil Procedure & Injunctions",
        "Criminal Procedure & Bail",
        "Registration & Stamp Duty",
        "Specific Performance & Contracts",
        "Family & Succession Law",
        "Constitutional & Writ Law",
        "Company & Commercial Law"
      ]
    },
    "governing_statutes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["act_name", "sections"],
        "properties": {
          "act_name": { "type": "string" },
          "sections": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "facts_summary": {
      "type": "string",
      "minLength": 30
    },
    "legal_issues": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "ratio_decidendi": {
      "type": "string",
      "description": "The binding legal principle formulated by the court",
      "minLength": 40
    },
    "exact_key_passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["paragraph_number", "quote_text"],
        "properties": {
          "paragraph_number": { "type": "integer" },
          "quote_text": { "type": "string", "minLength": 20 }
        }
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "STAGING_UNREVIEWED",
        "LAWYER_1_REVIEWED",
        "LAWYER_2_APPROVED",
        "PRODUCTION_LOCKED"
      ]
    },
    "audit_trail": {
      "type": "object",
      "properties": {
        "extracted_by": { "type": "string" },
        "reviewer_1": { "type": "string" },
        "reviewer_2": { "type": "string" },
        "approved_at": { "type": "string" }
      }
    }
  }
}
